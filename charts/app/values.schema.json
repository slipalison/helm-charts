{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "image", "port", "owner"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 40,
      "description": "Vira nome de namespace: minusculas, numeros e hifen."
    },
    "owner": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "not": { "const": "latest" },
          "description": "Sem :latest. Sem tag fixa nao ha rollback."
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "versao": {
      "type": "string",
      "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)?$",
      "description": "Versao semantica escrita pelo CI (1.4.0), ou vazio. Nunca a identidade do deploy: isso e image.tag."
    },
    "command": { "type": "array", "items": { "type": "string" } },
    "args": { "type": "array", "items": { "type": "string" } },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "description": "Acima de 1024: o container roda como nao-root e nao pode abrir porta privilegiada."
    },
    "host": { "type": "string" },
    "replicas": { "type": "integer", "minimum": 1 },
    "probes": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "description": "Porta das duas sondas. Ausente = port. Para o app que serve as sondas num listener interno, fora da porta que o gateway alcanca."
        }
      }
    },
    "canary": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "steps": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 99 }
        },
        "pause": { "type": "string" }
      }
    },
    "instrumentation": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "endpoint": { "type": "string", "format": "uri" },
        "protocol": { "enum": ["http/protobuf", "grpc"] },
        "environment": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "name": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_-]{0,62})?$",
          "not": { "enum": ["postgres", "template0", "template1", "app"] },
          "description": "Nome do banco. Vazio = nome do app. Hifen e aceito porque o padrao e o nome do app e o CNPG cita o identificador; em SQL escrito a mao ele precisa de aspas duplas."
        },
        "cluster": { "type": "string", "minLength": 1 },
        "clusterNamespace": { "type": "string", "minLength": 1 },
        "connectionLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80,
          "description": "O cluster tem max_connections: 100. Deixar um app chegar perto disso e deixa-lo derrubar os outros."
        }
      }
    },
    "egress": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "port"],
        "properties": {
          "host": { "type": "string" },
          "port": { "type": "integer" }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ambiente de preview por pull request. numero e tag sao escritos pelo ApplicationSet previews do homelab-gitops; vazio = producao.",
      "properties": {
        "numero": {
          "type": ["string", "integer"],
          "pattern": "^[0-9]*$",
          "description": "Numero do pull request. Vazio = producao."
        },
        "tag": {
          "type": "string",
          "pattern": "^(pr-[0-9]+-[0-9a-f]{7})?$",
          "description": "Tag da imagem do PR, pr-<numero>-<7 do head>, publicada pelo build-push.yml do github-workflows."
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] },
          "description": "Mapa nome: valor que sobrepoe o env pelo nome, so no preview. Mapa porque o Helm substitui listas inteiras."
        },
        "banco": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "imagem": { "type": "string", "pattern": "^ghcr\\.io/cloudnative-pg/postgresql:[0-9][0-9.]*$" },
            "tamanho": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" },
            "resources": { "type": "object" }
          }
        }
      }
    }
  }
}
